# =============================================================================
# Dockerfile.lambda — AWS Lambda Container Image
# =============================================================================
# This file is SEPARATE from the existing Dockerfile (EC2/Uvicorn).
# The existing Dockerfile is NOT modified and continues to work as before.
#
# Key differences from the EC2 Dockerfile:
#   • Base image:  public.ecr.aws/lambda/python:3.12
#                  (required by Lambda; includes the Lambda Runtime Interface
#                  Client and the Runtime Interface Emulator for local testing)
#   • No EXPOSE   (Lambda doesn't bind a port — API Gateway handles routing)
#   • CMD points to the Mangum handler, not Uvicorn
#   • LAMBDA_POOL_SIZE env var caps MongoDB connections per cold-start
# =============================================================================

FROM public.ecr.aws/lambda/python:3.12

# TASK_ROOT is set to /var/task by the AWS base image
WORKDIR ${LAMBDA_TASK_ROOT}

# ------------------------------------------------------------------
# Install Python dependencies
# ------------------------------------------------------------------
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------------
# Copy application code
# (the .dockerignore in backend/ excludes .env, .venv, __pycache__,
#  tests/, pytest.ini — no secrets are baked into the image)
# ------------------------------------------------------------------
COPY app/ ./app/

# ------------------------------------------------------------------
# Handler entrypoint
# Format: <module_path>.<callable>
# ------------------------------------------------------------------
CMD ["app.lambda_handler.handler"]
